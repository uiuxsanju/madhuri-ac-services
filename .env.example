# Production domain (no trailing slash). Used for canonical URLs, sitemap, OG, schema.
NEXT_PUBLIC_SITE_URL=https://www.madhurielectrical.in

# Optional: official Google Maps embed src (Google Maps → Share → Embed a map). Leave empty to show directions only.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Optional: form endpoint (Formspree / Web3Forms / your API) to receive booking form submissions as JSON.
# Leave empty: the form validates and asks the visitor to confirm on WhatsApp / call (no fake success).
NEXT_PUBLIC_BOOKING_ENDPOINT=

# Google Business Profile reviews link (Profile → Reviews / "Ask for reviews" link). Used by the reviews section.
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
